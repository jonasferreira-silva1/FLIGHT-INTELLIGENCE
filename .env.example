# ==============================================================================
# REC Flight Intelligence — Variáveis de Ambiente & Configurações de Segurança
# ==============================================================================
# INSTRUÇÕES DE SEGURANÇA DEVSECOPS:
# 1. NUNCA comite o arquivo `.env` real neste repositório. O Git ignora `.env`.
# 2. Copie este arquivo para `.env` na raiz do projeto:
#      cp .env.example .env
# 3. Substitua as senhas de exemplo por senhas fortes geradas aleatoriamente.
# ==============================================================================

# --- PostgreSQL (Persistência Principal) ---
POSTGRES_USER=rec
POSTGRES_PASSWORD=substitua_por_uma_senha_forte_para_o_postgres_2026
POSTGRES_DB=rec_flight
# URL usada internamente pelo Prisma ORM e backend NestJS:
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?schema=public

# --- Redis (Cache de Alta Performance & Deduplicação) ---
REDIS_PASSWORD=substitua_por_uma_senha_forte_para_o_redis_2026
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379

# --- Backend API (NestJS - Porta 3001) ---
PORT=3001
NODE_ENV=production
FRONTEND_URL=http://localhost:3000
ML_SERVICE_URL=http://localhost:8000

# --- Frontend (Next.js - Porta 3000) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_WS_URL=http://localhost:3001
