# ==============================================================================
# REC Flight Intelligence — Variáveis de Ambiente & Configurações de Segurança
# ==============================================================================
# INSTRUÇÕES DE SEGURANÇA DEVSECOPS:
# 1. NUNCA comite o arquivo `.env` real neste repositório. O Git ignora `.env`.
# 2. Copie este arquivo para `.env` na raiz do projeto:
#      cp .env.example .env
# 3. Preencha as senhas abaixo. Como os campos estão vazios, o Docker Compose
#    se recusará a subir (Fail-Closed) até que você defina valores válidos.
#
# DICA PARA GERAR SENHAS SEGURAS EM HEX (não quebram URLs):
#   - Linux / Git Bash:  openssl rand -hex 24
#   - PowerShell:
#     $b = New-Object byte[] 24; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); ($b | ForEach-Object { $_.ToString('x2') }) -join ''
# ==============================================================================

# --- PostgreSQL (Persistência Principal) ---
POSTGRES_USER=rec
POSTGRES_PASSWORD=
POSTGRES_DB=rec_flight
# URL usada internamente pelo Prisma ORM e backend NestJS:
DATABASE_URL=

# --- Redis (Cache de Alta Performance & Deduplicação) ---
REDIS_PASSWORD=
REDIS_URL=

# --- Backend API (NestJS - Porta 3001) ---
PORT=3001
NODE_ENV=production
FRONTEND_URL=http://localhost:3000
ML_SERVICE_URL=http://localhost:8000

# --- Frontend (Next.js - Porta 3000) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_WS_URL=http://localhost:3001
